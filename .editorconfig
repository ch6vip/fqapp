root = true

[*.{dart,rs,js,cjs,mjs}]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{dart,js,cjs,mjs}]
indent_size = 2
max_line_length = 80

[*.rs]
indent_size = 4
max_line_length = 100

[*.sh]
end_of_line = lf

[*.ps1]
end_of_line = crlf
