# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Local APK checkpoints survive flutter clean and are kept outside source control.
/release-archives/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/build/
/android/app/.cxx/

# Rust 原生核心（rust/）的构建输出。/android/app/src/main/jniLibs/*/*.so 已在下面忽略，
# 因此 Rust ARM64 库同样不入库，由 scripts/build_rust_backend.ps1 / .sh 重建。
/rust/target/

# Rust 原生核心（rust/）与 C 加密库都可由源码重建，不提交生成的 .so。
# shortplay 加密库由 native/ 中的 C 源码通过 CMake 构建。
/assets/config/device_pool.json
/android/app/src/main/jniLibs/*/*.so

# 正式签名材料：真品放在仓库之外，见 docs/release-signing.md。
# android/keystore.properties 只是本机构建用的副本，绝不能入库。
/android/keystore.properties
*.jks
*.keystore
*.pepk

# 本地临时文件
_sessionzip/
.workbuddy/
.agents/
.zcode/
