<?xml version="1.0" encoding="utf-8"?>
<!-- Cloud backup and D2D transfer both default to including filesDir and
     app_flutter. Turn them off so device_pool.json and Hive boxes never leave
     the device. allowBackup=false covers Auto Backup; this file is what
     actually disables Android 12+ device-to-device copies.
     Note: .agents/notes/implemented/bug-fix/2026-09-18-home-geometry-and-backup.md -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
