@@ -67,6 +67,45 @@ func extractUpstreamData(result interface{}) interface{} {
 	return result
 }
 
+// writeWebUpstreamResult checks the status before removing the upstream
+// envelope. HTTP 200 can still carry a business failure; keep its code, message,
+// and data intact so clients cannot mistake it for a successful empty result.
+// App note: fqapp/.agents/notes/implemented/bug-fix/2026-09-17-reviewed-runtime-boundaries.md
+func writeWebUpstreamResult(w http.ResponseWriter, result interface{}, transform func(interface{}) interface{}) {
+	if webUpstreamFailed(result) {
+		writeJSON(w, http.StatusOK, result)
+		return
+	}
+	data := extractUpstreamData(result)
+	if transform != nil {
+		data = transform(data)
+	}
+	writeJSON(w, http.StatusOK, webOK(data))
+}
+
+func webUpstreamFailed(result interface{}) bool {
+	envelope := asMap(result)
+	if envelope == nil {
+		return false
+	}
+	// Keep unwrapped payloads and the existing numeric success codes working.
+	// Compare fractional numbers directly: truncating 0.5 or 200.5 to int64
+	// would silently turn another explicit status into success.
+	switch code := envelope["code"].(type) {
+	case float64:
+		return code != 0 && code != 200
+	case int:
+		return code != 0 && code != 200
+	case int64:
+		return code != 0 && code != 200
+	case json.Number:
+		number, err := code.Float64()
+		return err != nil || (number != 0 && number != 200)
+	default:
+		return false
+	}
+}
