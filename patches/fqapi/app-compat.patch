@@ -0,0 +1,77 @@
+package endpoints
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/url"
+
+	"/internal/upstream"
+)
+
+// IdeaList implements the "item ideas" endpoint
+// (POST /api/v1/chapters/{id}/reviews and
+// POST /api/v1/chapters/{id}/paragraphs/{n}/reviews). Device-signed (mode A),
+// reading family.
+//
+// "Ideas" (想法) are the paragraph and chapter-end comments the reader shows.
+// They are served by a different service than book reviews: the book comment
+// list (/novel/commentapi/comment/list/) accepts only comment_type=2 (book) and
+// answers `103001 invalid param / comment_type invalid` for the item and
+// paragraph comment types, so a chapter forum cannot be read through it.
+//
+// The response is keyed by paragraph id; each entry carries the idea count, the
+// per-channel bubble counters and the comment ids, but not the comment bodies.
+//
+// Query params:
+//
+//	item_id        (required) chapter item id
+//	item_version   (optional) chapter content version; passed through when known
+//	comment_source (optional, default 3) UgcCommentSourceEnum:
+//	               3=NovelParaCommentExposed (paragraph ideas),
+//	               4=NovelItemComment. Source 1 (NovelBookComment) returns the
+//	               per-paragraph counts with empty `infos`.
+type IdeaList struct {
+	up *upstream.Client
+}
+
+// NewIdeaList builds the item-ideas endpoint.
+func NewIdeaList(up *upstream.Client, _ Config) *IdeaList {
+	return &IdeaList{up: up}
+}
+
+const ideaListPath = "/novel/commentapi/idea/list/"
+
+// Handle implements Endpoint.
+func (c *IdeaList) Handle(q url.Values) (interface{}, error) {
+	itemID := q.Get("item_id")
+	if itemID == "" {
+		return nil, errBadRequest("缺少item_id参数")
+	}
+
+	body, err := ideaListBody(itemID, q.Get("item_version"), intDefault(q.Get("comment_source"), 3))
+	if err != nil {
+		return nil, err
+	}
+
+	return NewUpstreamClient(c.up).JSON(UpstreamRequestSpec{
+		Mode:    ModeDeviceSigned,
+		Method:  http.MethodPost,
+		Host:    hostFQNovel,
+		Path:    ideaListPath + url.PathEscape(itemID) + "/v1/",
+		Params:  reading724(nil),
+		Body:    body,
+		Headers: dragonReadJSONHeaders(),
+	})
+}
+
+// ideaListBody builds the upstream request body. Split out so the wire
+// contract can be asserted without a network round trip.
+func ideaListBody(itemID, itemVersion string, commentSource int) ([]byte, error) {
+	return json.Marshal(map[string]interface{}{
+		"comment_source":    commentSource,
+		"compliance_status": 0,
+		"item_id":           itemID,
+		"item_version":      itemVersion,
+		"server_channel":    7,
+	})
+}
