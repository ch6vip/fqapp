+
+// splitCSV parses a comma separated id list, dropping blanks.
+func splitCSV(value string) []string {
+	if strings.TrimSpace(value) == "" {
+		return nil
+	}
+	parts := strings.Split(value, ",")
+	ids := make([]string, 0, len(parts))
+	for _, part := range parts {
+		if trimmed := strings.TrimSpace(part); trimmed != "" {
+			ids = append(ids, trimmed)
+		}
+	}
+	if len(ids) == 0 {
+		return nil
+	}
+	return ids
+}
diff --git a/internal/endpoints/content_decryption_test.go b/internal/endpoints/content_decryption_test.go
new file mode 100644
index 0000000..7b77790
--- /dev/null
+++ b/internal/endpoints/content_decryption_test.go
@@ -0,0 +1,74 @@
+package endpoints
+
+import (
+	"bytes"
+	"crypto/aes"
+	"crypto/cipher"
+	"encoding/base64"
+	"encoding/json"
+	"math/big"
+	"net/http"
+	"testing"
+
+	"/internal/upstream"
+)
+
+func TestNovelContentDecryptsBodyWhenHeaderIsAFlag(t *testing.T) {
+	plain := `<p>女主人设</p><img src="https://example.com/portrait.webp?a=1&amp;b=2" img-width="1400" img-height="2100"/>`
+	key, encrypted, state := novelContentFixture([]byte(plain))
+	for _, headerCipher := range []string{"1", "", encrypted} {
+		t.Run("cipher-header-"+headerCipher[:min(len(headerCipher), 3)], func(t *testing.T) {
+			bodyContent := encrypted
+			if headerCipher == encrypted {
+				bodyContent = "" // Older protocol: ciphertext lives in the header.
+			}
+			raw, _ := json.Marshal(map[string]interface{}{
+				"code": 0,
+				"data": map[string]interface{}{"content": bodyContent, "item_id": "chapter"},
+			})
+			headers := http.Header{"Y": {key}, "C": {headerCipher}}
+			result, err := setDHContentInPlace(raw, headers, state)
+			if err != nil {
+				t.Fatal(err)
+			}
+			data := result.(map[string]interface{})["data"].(map[string]interface{})
+			if data["content"] != plain || data["content_decrypted"] != true || data["item_id"] != "chapter" {
+				t.Fatalf("decrypted chapter did not preserve its HTML, metadata and success marker: %#v", data)
+			}
+		})
+	}
+}
+
+func TestNovelContentDoesNotReturnCiphertextAsSuccessfulText(t *testing.T) {
+	key, _, state := novelContentFixture([]byte("正文"))
+	for _, headers := range []http.Header{
+		{"Y": {key}, "C": {"1"}},
+		{"C": {"1"}},
+	} {
+		_, err := setDHContentInPlace([]byte(`{"code":0,"data":{"content":"not base64!"}}`), headers, state)
+		if err == nil {
+			t.Fatal("an encrypted response without valid ciphertext/key must fail")
+		}
+	}
+	key, encrypted, state := novelContentFixture([]byte{0xff, 0xfe, 0xff})
+	raw, _ := json.Marshal(map[string]interface{}{"data": map[string]string{"content": encrypted}})
+	if _, err := setDHContentInPlace(raw, http.Header{"Y": {key}, "C": {"1"}}, state); err == nil {
+		t.Fatal("invalid UTF-8 must not be published as a readable chapter")
+	}
+}
+
+// With client exponent 1 and a server value smaller than the DH modulus, the
+// shared secret is exactly the server value. This exercises real CBC decoding
+// without network requests or copying production device credentials.
+func novelContentFixture(plain []byte) (string, string, *upstream.DHState) {
+	serverValue := bytes.Repeat([]byte{0x37}, 40)
+	block, _ := aes.NewCipher(serverValue[:32])
+	iv := bytes.Repeat([]byte{0x18}, aes.BlockSize)
+	pad := aes.BlockSize - len(plain)%aes.BlockSize
+	padded := append(append([]byte{}, plain...), bytes.Repeat([]byte{byte(pad)}, pad)...)
+	ciphertext := make([]byte, len(padded))
+	cipher.NewCBCEncrypter(block, iv).CryptBlocks(ciphertext, padded)
+	return base64.StdEncoding.EncodeToString(serverValue),
+		base64.StdEncoding.EncodeToString(append(iv, ciphertext...)),
+		&upstream.DHState{A: big.NewInt(1)}
+}
