+		return nil, fmt.Errorf("decrypt novel content: %w", err)
+	}
+	if len(plain) == 0 || !utf8.Valid(plain) {
+		return nil, fmt.Errorf("decrypted novel content is empty or invalid UTF-8")
+	}
+	result, err := setContentInPlace(raw, string(plain))
+	if err != nil {
+		return nil, err
+	}
+	if root, ok := result.(map[string]interface{}); ok {
