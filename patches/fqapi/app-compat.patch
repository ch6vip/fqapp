@@ -0,0 +1,246 @@
+package endpoints
+
+import (
+	"encoding/json"
+	"errors"
+	"net/url"
+	"strings"
+	"testing"
+)
+
+func TestIdeaListRequiresItemID(t *testing.T) {
+	// A nil upstream client proves the validation returns before any network
+	// use; a regression that drops the check would panic here.
+	ep := NewIdeaList(nil, Config{})
+	if _, err := ep.Handle(url.Values{}); err == nil {
+		t.Fatal("want an error when item_id is missing")
+	} else {
+		var bad badRequest
+		if !errors.As(err, &bad) {
+			t.Fatalf("want a badRequest (HTTP 400), got %T: %v", err, err)
+		}
+	}
+}
+
+func TestIdeaListBodyContract(t *testing.T) {
+	body, err := ideaListBody("7491705434915488318", "", 3)
+	if err != nil {
+		t.Fatalf("build body: %v", err)
+	}
+	var got map[string]interface{}
+	if err := json.Unmarshal(body, &got); err != nil {
+		t.Fatalf("unmarshal body: %v", err)
+	}
+
+	// NovelParaCommentExposed: asking as a book comment (source 1) makes the
+	// upstream return empty `infos`.
+	if got["comment_source"] != float64(3) {
+		t.Errorf("comment_source = %v, want 3 (NovelParaCommentExposed)", got["comment_source"])
+	}
+	if got["item_id"] != "7491705434915488318" {
+		t.Errorf("item_id = %v", got["item_id"])
+	}
+	if got["server_channel"] != float64(7) {
+		t.Errorf("server_channel = %v, want 7", got["server_channel"])
+	}
+	if _, ok := got["item_version"]; !ok {
+		t.Error("item_version must always be present (empty string is valid)")
+	}
+}
+
+func TestBookReviewsRequiresBookOrGroup(t *testing.T) {
+	ep := NewBookReviews(nil, Config{})
+	if _, err := ep.Handle(url.Values{}); err == nil {
+		t.Fatal("want an error when neither book_id nor group_id is given")
+	} else {
+		var bad badRequest
+		if !errors.As(err, &bad) {
+			t.Fatalf("want a badRequest (HTTP 400), got %T: %v", err, err)
+		}
+	}
+}
+
+// The idea list returns comment ids without bodies; the client resolves them
+// through insert_comment_ids. It must stay absent from the book-review request
+// so that request remains byte for byte identical.
+func TestBookReviewBodyInsertIDs(t *testing.T) {
+	base := bookReviewParams{
+		BookID:        "7491705400958405694",
+		GroupID:       "7491705434915488318",
+		GroupType:     1,
+		CommentSource: 1,
+		CommentType:   2,
+		ServerChannel: 7,
+		Count:         20,
+		Sort:          1,
+		FoldType:      1,
+	}
+
+	absent, err := bookReviewBody(base)
+	if err != nil {
+		t.Fatalf("build body: %v", err)
+	}
+	if strings.Contains(string(absent), "insert_comment_ids") {
+		t.Error("insert_comment_ids must be omitted when no ids are given")
+	}
+
+	base.InsertIDs = []string{"7508330344748876606", "7459605510494946110"}
+	present, err := bookReviewBody(base)
+	if err != nil {
+		t.Fatalf("build body: %v", err)
+	}
+	var got struct {
+		BusinessParam struct {
+			InsertIDs []string `json:"insert_comment_ids"`
+		} `json:"business_param"`
+	}
+	if err := json.Unmarshal(present, &got); err != nil {
+		t.Fatalf("unmarshal body: %v", err)
+	}
+	want := []string{"7508330344748876606", "7459605510494946110"}
+	if len(got.BusinessParam.InsertIDs) != len(want) {
+		t.Fatalf("insert_comment_ids = %v, want %v", got.BusinessParam.InsertIDs, want)
+	}
+	for i := range want {
+		if got.BusinessParam.InsertIDs[i] != want[i] {
+			t.Errorf("insert_comment_ids[%d] = %q, want %q",
+				i, got.BusinessParam.InsertIDs[i], want[i])
+		}
+	}
+}
+
+func TestSplitCSV(t *testing.T) {
+	cases := []struct {
+		in   string
+		want int
+	}{
+		{"", 0},
+		{"   ", 0},
+		{"a", 1},
+		{"a,b", 2},
+		{" a , b ", 2},
+		{"a,,b", 2},
+		{",", 0},
+	}
+	for _, c := range cases {
+		if got := splitCSV(c.in); len(got) != c.want {
+			t.Errorf("splitCSV(%q) = %v, want %d entries", c.in, got, c.want)
+		}
+	}
+}
+
+// The book-review defaults are the historical request. Every new parameter was
+// added for paragraph comments, so this asserts book reviews did not shift.
+func TestBookReviewBodyDefaultsMatchBookReviews(t *testing.T) {
+	body, err := bookReviewBody(bookReviewParams{
+		BookID:        "7491705400958405694",
+		GroupID:       "7491705400958405694",
+		GroupType:     1,
+		CommentSource: 1,
+		CommentType:   2,
+		ServerChannel: 7,
+		Count:         20,
+		Sort:          1,
+		FoldType:      1,
+	})
+	if err != nil {
+		t.Fatalf("build body: %v", err)
+	}
+	var got struct {
+		BusinessParam map[string]interface{} `json:"business_param"`
+		CommentSource int                    `json:"comment_source"`
+		CommentType   int                    `json:"comment_type"`
+		Count         int                    `json:"count"`
+		GroupID       string                 `json:"group_id"`
+		GroupType     int                    `json:"group_type"`
+		ServerChannel int                    `json:"server_channel"`
+		Sort          int                    `json:"sort"`
+	}
+	if err := json.Unmarshal(body, &got); err != nil {
+		t.Fatalf("unmarshal body: %v", err)
+	}
+
+	if got.CommentSource != 1 {
+		t.Errorf("comment_source = %d, want 1 (NovelBookComment)", got.CommentSource)
+	}
+	if got.CommentType != 2 {
+		t.Errorf("comment_type = %d, want 2 (Book)", got.CommentType)
+	}
+	if got.GroupType != 1 {
+		t.Errorf("group_type = %d, want 1 (UgcRelativeType.Book)", got.GroupType)
+	}
+	if got.GroupID != "7491705400958405694" {
+		t.Errorf("group_id = %q, want the book id", got.GroupID)
+	}
+	if got.ServerChannel != 7 || got.Count != 20 || got.Sort != 1 {
+		t.Errorf("channel/count/sort = %d/%d/%d, want 7/20/1",
+			got.ServerChannel, got.Count, got.Sort)
+	}
+	if got.BusinessParam["para_index"] != float64(0) {
+		t.Errorf("business_param.para_index = %v, want 0", got.BusinessParam["para_index"])
+	}
+	if got.BusinessParam["need_count"] != true {
+		t.Errorf("business_param.need_count = %v, want true", got.BusinessParam["need_count"])
+	}
+	if got.BusinessParam["book_id"] != "7491705400958405694" {
+		t.Errorf("business_param.book_id = %v", got.BusinessParam["book_id"])
+	}
+}
+
+// The paragraph-comment recipe the official client uses: the container is the
+// chapter item, not the book, and comment_type must pair with comment_source.
+func TestBookReviewBodyParagraphRecipe(t *testing.T) {
+	body, err := bookReviewBody(bookReviewParams{
+		BookID:        "7491705400958405694",
+		GroupID:       "7491705434915488318",
+		GroupType:     15,
+		CommentSource: 2,
+		CommentType:   1,
+		ServerChannel: 43,
+		ParaIndex:     28,
+		ItemVersion:   "b271c896b27dbe2e51c2ca26deabade2_1_27cec4ca0ef5f7f",
+		Count:         20,
+		Sort:          1,
+		FoldType:      1,
+	})
+	if err != nil {
+		t.Fatalf("build body: %v", err)
+	}
+	var got struct {
+		BusinessParam map[string]interface{} `json:"business_param"`
+		CommentSource int                    `json:"comment_source"`
+		CommentType   int                    `json:"comment_type"`
+		GroupID       string                 `json:"group_id"`
+		GroupType     int                    `json:"group_type"`
+		ServerChannel int                    `json:"server_channel"`
+	}
+	if err := json.Unmarshal(body, &got); err != nil {
+		t.Fatalf("unmarshal body: %v", err)
+	}
+
+	if got.CommentSource != 2 || got.CommentType != 1 {
+		t.Errorf("comment_source/type = %d/%d, want 2/1 (NovelParaComment/Paragraph)",
+			got.CommentSource, got.CommentType)
+	}
+	if got.GroupType != 15 {
+		t.Errorf("group_type = %d, want 15 (UgcRelativeType.Item)", got.GroupType)
+	}
+	if got.ServerChannel != 43 {
+		t.Errorf("server_channel = %d, want 43 (NovelParaUserCommentList)", got.ServerChannel)
+	}
+	if got.GroupID != "7491705434915488318" {
+		t.Errorf("group_id = %q, want the chapter item id", got.GroupID)
+	}
+	// The upstream rejects the request unless book_id, para_index and
+	// item_version are all usable.
+	if got.BusinessParam["book_id"] != "7491705400958405694" {
+		t.Errorf("business_param.book_id = %v, want the real book id",
+			got.BusinessParam["book_id"])
+	}
+	if got.BusinessParam["para_index"] != float64(28) {
+		t.Errorf("business_param.para_index = %v, want 28", got.BusinessParam["para_index"])
+	}
+	if got.BusinessParam["item_version"] != "b271c896b27dbe2e51c2ca26deabade2_1_27cec4ca0ef5f7f" {
+		t.Errorf("business_param.item_version = %v", got.BusinessParam["item_version"])
+	}
+}
